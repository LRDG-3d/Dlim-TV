{
  "name": "televisa-catalogo",
  "version": "1.0.0",
  "private": true,
  "description": "Dlim TV · Ionic React + Capacitor (Android)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "android:init": "npx cap add android && node scripts/patch-android.mjs",
    "assets": "npx --yes @capacitor/assets generate --android",
    "sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "apk:debug": "npm run sync && cd android && ./gradlew assembleDebug",
    "apk:release": "npm run sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/keyboard": "^6.0.2",
    "@capacitor/preferences": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "@ionic/react": "^8.3.0",
    "@ionic/react-router": "^8.3.0",
    "ionicons": "^7.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0"
  }
}
